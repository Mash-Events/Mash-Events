{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/internal/keep-alive",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/internal/messages/drain",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/internal/retention-purge",
      "schedule": "45 4 * * *"
    }
  ]
}
