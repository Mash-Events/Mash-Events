# Placeholders only. This repository is public: never put real values here.
# Set real values in Vercel (per environment) or a local .env.local.

MASH_ENV=development
SITE_URL=http://admin.localhost:3000

# Hosts (comma-separated). Org hosts come from sites/registry.ts.
MASH_ADMIN_HOSTS=admin.localhost
MASH_ROOT_HOSTS=localhost,127.0.0.1

# Supabase (Mash project; staging for previews, production for main)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Signing secrets (32+ random bytes each; HKDF derives per-event keys, design §12.6)
PASS_MASTER_SECRET=
LINK_MASTER_SECRET=
SESSION_ACTIVITY_SECRET=
CRON_SECRET=

# Resend (email)
RESEND_API_KEY=re_xxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
RESEND_DEFAULT_FROM=events@mash.example
# Without RESEND_API_KEY outside production, emails are logged, not sent.

# Azure Communication Services (WhatsApp, design §8.1)
AZURE_WHATSAPP_ENABLED=false
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=
AZURE_WHATSAPP_CHANNEL_REGISTRATION_ID=
AZURE_EVENT_GRID_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
